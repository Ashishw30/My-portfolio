{
  "info": {
    "name": "QA Sample Collection (Demo)",
    "_postman_id": "00000000-0000-0000-0000-000000000000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"qa@example.com\",\n  \"password\": \"Password@123\"\n}"
        }
      }
    },
    {
      "name": "Users - List",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/users?limit=5", "host": ["{{baseUrl}}"], "path": ["api", "users"], "query": [{ "key": "limit", "value": "5" }] }
      }
    },
    {
      "name": "RBAC - Admin Exports (Forbidden for Viewer)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/admin/exports", "host": ["{{baseUrl}}"], "path": ["api", "admin", "exports"] }
      }
    }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:5173" }]
}

